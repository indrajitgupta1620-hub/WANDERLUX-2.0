              "path": ["api", "flights"],
              "query": [
                { "key": "from", "value": "Delhi" },
                { "key": "to", "value": "Mumbai" },
                { "key": "maxPrice", "value": "6000" },
                { "key": "sort", "value": "cheapest" }
              ]
            },
            "description": "Demonstrates Query Parameters filtering flights by origin, destination, and budget."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Filtered results match criteria\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    json.data.forEach(function(flight) {",
                  "        pm.expect(flight.price).to.be.at.most(6000);",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
